#version 450
#extension GL_GOOGLE_include_directive : require
// SMAA's second pass: the blending weights along each edge's pattern.
#include "smaa_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D edgesTex;
layout(set = 0, binding = 1) uniform sampler2D areaTex;
layout(set = 0, binding = 2) uniform sampler2D searchTex;      // (point-sampled)
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D weights;

void main() {
    const ivec2 p = Pixel();
    if (Outside(p)) return;
    const vec2 uv = TexCoord(p);
    vec2 pixcoord;
    vec4 offset[3];
    SMAABlendingWeightCalculationVS(uv, pixcoord, offset);
    imageStore(weights, p, SMAABlendingWeightCalculationPS(uv, pixcoord, offset, edgesTex, areaTex, searchTex, vec4(0.0)));
}
