#version 450
#extension GL_GOOGLE_include_directive : require
// SMAA's third pass: each pixel blended with its neighbours by the weights.
#include "smaa_common.glsl"

layout(set = 0, binding = 0) uniform sampler2D colorTex;
layout(set = 0, binding = 1) uniform sampler2D blendTex;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D smoothed;

void main() {
    const ivec2 p = Pixel();
    if (Outside(p)) return;
    const vec2 uv = TexCoord(p);
    vec4 offset;
    SMAANeighborhoodBlendingVS(uv, offset);
    imageStore(smoothed, p, vec4(SMAANeighborhoodBlendingPS(uv, offset, colorTex, blendTex).rgb, 1.0));
}
